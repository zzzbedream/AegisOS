# Only testnet endpoints belong here. Do not commit private keys.
AEGIS_STELLAR_RPC=https://soroban-testnet.stellar.org
AEGIS_STELLAR_NETWORK=Test SDF Network ; September 2015
AEGIS_ETHEREUM_RPC=https://sepolia.example-rpc.invalid
AEGIS_DASHBOARD_PORT=4173

# Copy this file to .env (gitignored); the demo scripts load it automatically.
# Stellar secret keys stay in the stellar CLI keystore, not here:
#   AEGIS_BUYER_SECRET="$(stellar keys show aegis-buyer)" npm run demo:attack

# Reclaim zkFetch (guarantee D): credentials of your app at dev.reclaimprotocol.org.
# Only in .env: never in the repo, a receipt, a ledger event or agent context.
AEGIS_RECLAIM_APP_ID=
AEGIS_RECLAIM_APP_SECRET=
